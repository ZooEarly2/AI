# --- 공통 ---
ENV=local
PROVIDER=mock                   # mock | real  (초반엔 mock으로 Spring 연동, 준비되면 real)
LOG_LEVEL=INFO

# --- OpenAI (번역 · 동화 · 표현 교정 · 한국어 외 TTS) ---
OPENAI_API_KEY=sk-...
# gpt-5 계열은 답하기 전에 "추론 토큰"을 쓴다. 그대로 두면 동화 4장면 생성이
# 게이트웨이 60초 제한을 넘겼다 — 호출마다 필요한 만큼만 주도록 코드에서 지정한다
# (openai_client.reasoning: 번역·대화 minimal / 동화·표현교정 low).
OPENAI_LLM_MODEL=gpt-5-mini
# 한국어는 CLOVA 로 만든다. 아래 둘은 베트남어·중국어처럼 CLOVA 가 못 하는 언어와,
# CLOVA 가 실패했을 때의 대체 경로에 쓰인다.
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral           # 다른 옵션: alloy, ash, echo, sage, shimmer, verse 등
OPENAI_TIMEOUT_SEC=40            # 호출당 상한. SDK 기본값(600초)은 게이트웨이보다 10배 길다
OPENAI_MAX_RETRIES=1             # 재시도는 게이트웨이 예산 안에서만 뜻이 있다

# --- CLOVA Voice Premium (한국어 TTS) ---
# 네이버 클라우드 콘솔 > AI·NAVER API > Application 에서 발급한다.
# CLOVA 는 베트남어를 지원하지 않는다 — 그 언어는 자동으로 OpenAI TTS 로 넘어간다.
CLOVA_CLIENT_ID=
CLOVA_CLIENT_SECRET=
CLOVA_TTS_VOICE=nara             # 선생님 목소리. 다른 옵션: nminyoung, njiyun, ndain(어린이) 등
CLOVA_TTS_VOICE_FRIEND=ndain     # 또래 친구(호랑이) 목소리. 비우면 위 목소리를 함께 쓴다
CLOVA_TIMEOUT_SEC=15

# 앱이 보내는 속도 "배수"의 기본값(0.5~1.5, 클수록 빠르다).
# CLOVA 는 눈금이 반대(-5~5, 클수록 느리다)라 clova_client 가 뒤집어 보낸다.
TTS_DEFAULT_SPEED=0.9            # 만 5~8세 아동 기준 청취 속도

# --- faster-whisper (STT, 로컬 실행) ---
WHISPER_MODEL_SIZE=small         # tiny(가장 빠름/부정확) < base < small(권장) < medium(느림/정확)
WHISPER_DEVICE=cpu               # M4 맥북은 GPU(MPS) 미지원 라이브러리라 cpu 고정
WHISPER_COMPUTE_TYPE=int8        # int8 양자화로 CPU에서도 속도 확보

# --- 언어 ---
SUPPORTED_LANGUAGES=ko,vi,zh

# --- 오디오 ---
TEMP_AUDIO_DIR=/tmp/juelri-audio
MAX_AUDIO_DURATION_SEC=30

# --- CORS ---
# 정상 경로(게이트웨이 → FastAPI)는 서버 대 서버라 CORS 와 무관하다.
# 이 값은 브라우저에서 /docs 를 열거나 프론트를 FastAPI 에 직접 붙여 볼 때만 쓰인다.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081

# --- 인증 ---
# 게이트웨이가 X-API-Key 헤더로 보낸다. 비워두면 인증하지 않는다(로컬 전용).
# 배포에서는 반드시 채우고, 게이트웨이의 INFERENCE_API_KEY 와 같은 값을 준다.
API_KEY=

# --- 발음 채점 (wav2vec-base-finetuning, Azure 배포된 word_scorer_v0.1/serve) ---
# 배포된 채점 서비스 주소 (PRONUNCIATION_API.md §1). 끝에 슬래시를 붙이지 않는다 — //score 가 되어 404다.
# 키는 Azure 포털 → Container Apps → pron-scorer → 환경 변수 → API_KEY 에서 가져온다.
SCORING_API_BASE_URL=https://pron-scorer.icymoss-b044a0b4.japaneast.azurecontainerapps.io
SCORING_API_KEY=
SCORING_TIMEOUT_SEC=30
SCORING_MAX_UPLOAD_MB=20
